# ---------------------------------------------------------------------------
# Blog API — example configuration.
# Copy to `.env` and adjust. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- HTTP server -----------------------------------------------------------
APP_ENV=development
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
# Per-request handler deadline enforced by middleware.Timeout.
HTTP_HANDLER_TIMEOUT=10s
# Maximum accepted JSON request body, in bytes (1 MiB).
HTTP_MAX_BODY_BYTES=1048576
# Grace period for in-flight requests during shutdown.
SHUTDOWN_TIMEOUT=15s

# --- Database --------------------------------------------------------------
# libpq-style URL consumed by pgx.
DATABASE_URL=postgres://blog:blog@localhost:5432/blog?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=10s

# --- Authentication --------------------------------------------------------
# REQUIRED. Minimum 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-bytes-of-random-secret
JWT_ISSUER=majoo-blog-api
JWT_AUDIENCE=majoo-blog-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
# bcrypt cost. 10 is the library default; 12 is a good production value.
BCRYPT_COST=12

# --- Rate limiting (in-process token bucket) -------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
# Stricter bucket applied to /auth/register and /auth/login.
AUTH_RATE_LIMIT_RPS=1
AUTH_RATE_LIMIT_BURST=10

# --- CORS ------------------------------------------------------------------
# Comma-separated exact origins. "*" is rejected when APP_ENV=production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Logging ---------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

# --- Async event worker pool ----------------------------------------------
EVENTS_WORKERS=4
EVENTS_BUFFER=256
